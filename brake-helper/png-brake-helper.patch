+# -------------------------------------- IMPORTS -----------------------------------------------------------------------
+
+from pathlib import Path
+from typing import final
+
+from lib.config import OverlayId, PngSettings
+from lib.file_path import get_app_fixed_dir
+from lib.logger import PngLogger
+
+from ...hf_types import BrakeHelperData
+from ..base.base_overlay import BaseOverlay
+from .brake_engine import BrakeEngine
+
+# -------------------------------------- CLASSES -----------------------------------------------------------------------
+
+class BrakeHelperOverlay(BaseOverlay):
+    """
+    Brake helper: a capsule with the brake bias block and a bar that fills towards the
+    live brake point for the next corner, drains while braking and flashes the result.
+
+    All logic lives in BrakeEngine (no Qt). References are stored per track in
+    <app data>/brake_helper/track_<id>.json.
+    """
+
+    QML_FILE = Path(__file__).parent / "brake_helper.qml"
+    OVERLAY_ID = OverlayId.BRAKE_HELPER
+    ANIMATION_DRIVEN = True
+
+    def __init__(self, settings: PngSettings, logger: PngLogger) -> None:
+        super().__init__(settings, logger)
+        self._engine = BrakeEngine(
+            store_dir=str(get_app_fixed_dir() / "brake_helper"),
+            warn_s=settings.HUD.brake_helper_warn_sec,
+            log=logger.debug,
+        )
+        self._last_seq = -1
+        self.subscribe_hf(BrakeHelperData)
+
+    @final
+    def render_frame(self):
+        """Feed each new sample to the engine once and push the view to QML."""
+        data = self.get_latest_hf_data(BrakeHelperData)
+        if not data or data.__seq__ == self._last_seq:
+            return
+        self._last_seq = data.__seq__
+        try:
+            view = self._engine.update(data, data.__timestamp__ / 1e9)
+        except Exception:  # pylint: disable=broad-exception-caught
+            self.logger.exception("Brake helper engine failed")
+            return
+        self.invoke_qml_method("updateView", view)
