+# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+# SOFTWARE.
+
+"""Brake helper engine (no Qt): learns the player's own braking per corner and
+computes a live brake point every frame.
+
+Brake point:  point = apex - (v_now^2 - v_target^2) / (2 * a_now)
+  v_now     live speed
+  v_target  own best minimum speed for the corner, scaled by current grip
+  a_now     own best average deceleration for the corner, scaled by current grip
+            (tyre wear + temps, fuel, wetness), a learned correction from recent
+            zones (achieved decel without lock-ups), and battle offsets
+            (off the normal line, close behind a car).
+
+At reference conditions this gives exactly the reference brake point.
+
+Wheel arrays are RL, RR, FL, FR (game order).
+"""
+
+# -------------------------------------- IMPORTS -----------------------------------------------------------------------
+
+import itertools
+import json
+import math
+import os
+from dataclasses import dataclass, field
+from typing import Any, Callable, Dict, List, Optional
+
+# -------------------------------------- CONSTANTS ---------------------------------------------------------------------
+
+WHITE_LEAD_S = 2.0          # white line starts filling this long before the point
+FLASH_S = 1.3               # result flash after the corner
+LINE_BIN_M = 10.0           # racing line resolution
+GATE_IN_M = 150.0           # segment timing gate before the brake point
+GATE_OUT_M = 100.0          # segment timing gate after the apex
+MATCH_M = 60.0              # a zone belongs to a corner if its apex is this close
+MIN_DROP_KMPH = 25.0        # smaller slow-downs are lifts, not braking zones
+BRAKE_ON = 0.20
+BRAKE_OFF = 0.05
+LOCK_SLIP = 0.12            # |slip ratio| above this while braking = locking
+BB_MAX_CHANGES = 3
+BB_MIN_GAP_S = 5.0
+CAR_MASS_KG = 800.0
+
+# Result colours / names (spec)
+RESULTS = {
+    "good":    ("#34d27b", "Good"),
+    "later":   ("#3d8bff", "Brake later"),
+    "earlier": ("#ff8a1f", "Brake earlier"),
+    "harder":  ("#b26bff", "Brake harder"),
+    "less":    ("#22d3c5", "Brake less"),
+}
+
+# Grip vs conditions for each tyre class. Weather enum: 0 clear, 1 light cloud,
+# 2 overcast, 3 light rain, 4 heavy rain, 5 storm (6 = thunderstorm).
+_WET_GRIP = {
+    "dry":   [1.00, 1.00, 1.00, 0.75, 0.60, 0.55, 0.55],
+    "inter": [0.88, 0.88, 0.88, 0.84, 0.72, 0.64, 0.64],
+    "wet":   [0.80, 0.80, 0.80, 0.78, 0.74, 0.70, 0.70],
+}
+# Surface temp window (C) per tyre class
+_TEMP_WINDOW = {"dry": (85.0, 105.0), "inter": (60.0, 90.0), "wet": (45.0, 80.0)}
+
+# -------------------------------------- HELPERS -----------------------------------------------------------------------
+
+def tyre_class(visual_compound: Optional[int]) -> str:
+    """7 = intermediate, 8 = wet (F1 modern + classic), everything else is a slick."""
+    if visual_compound == 7:
+        return "inter"
+    if visual_compound == 8:
+        return "wet"
+    return "dry"
+
+def _clamp(v: float, lo: float, hi: float) -> float:
+    return lo if v < lo else hi if v > hi else v
+
+def _wrap(delta: float, length: float) -> float:
+    """Wrap a distance difference into (-L/2, L/2]."""
+    if not length:
+        return delta
+    delta = (delta + length / 2) % length - length / 2
+    return delta
+
+def _avg(values: Optional[List[float]], idx=(0, 1, 2, 3)) -> Optional[float]:
+    if not values:
+        return None
+    vals = [values[i] for i in idx if i < len(values) and values[i] is not None]
+    return sum(vals) / len(vals) if vals else None
+
+# -------------------------------------- DATA --------------------------------------------------------------------------
+
+@dataclass
+class Zone:
+    """One braking zone as it happens."""
+    start_d: float
+    start_t: float
+    v_entry: float                  # m/s
+    bias: Optional[int]
+    corner: Optional[int] = None    # index into corners when known at start
+    point_d: Optional[float] = None # live brake point when braking started
+    v_target: Optional[float] = None
+    min_v: float = 1e9
+    min_d: float = 0.0
+    end_d: Optional[float] = None   # brake released
+    peak: float = 0.0
+    frames: int = 0
+    front_lock: int = 0
+    rear_lock: int = 0
+    grip: float = 1.0
+    lap_invalid: bool = False
+    traffic: bool = False           # a car was close ahead: outcome not judged
+
+@dataclass
+class Corner:
+    apex: float
+    refs: Dict[str, Dict[str, float]] = field(default_factory=dict)
+    bias_target: Optional[float] = None
+    bias_n: int = 0
+    bias_weight: float = 1.0
+    gap_prev_s: Optional[float] = None
+    confirmed: bool = True          # False until the lap it was found on is completed (not pitted)
+    misses: int = 0                 # completed laps in a row without braking here
+
+    def to_json(self) -> Dict[str, Any]:
+        return {"apex": round(self.apex, 1), "refs": self.refs,
+                "bias_target": self.bias_target, "bias_n": self.bias_n,
+                "bias_weight": round(self.bias_weight, 3), "gap_prev_s": self.gap_prev_s,
+                "misses": self.misses}
+
+    @classmethod
+    def from_json(cls, d: Dict[str, Any]) -> "Corner":
+        return cls(apex=d["apex"], refs=d.get("refs", {}), bias_target=d.get("bias_target"),
+                   bias_n=d.get("bias_n", 0), bias_weight=d.get("bias_weight", 1.0),
+                   gap_prev_s=d.get("gap_prev_s"), misses=d.get("misses", 0))
+
+# -------------------------------------- ENGINE ------------------------------------------------------------------------
+
+class BrakeEngine:
+    """Feed it one sample per telemetry frame with update(sample, t). It returns the view."""
+
+    def __init__(self, store_dir: Optional[str] = None, warn_s: float = 0.5,
+                 log: Optional[Callable[[str], None]] = None) -> None:
+        self.store_dir = store_dir
+        self.warn_s = warn_s
+        self.log = log or (lambda _m: None)
+        self.track_id: Optional[int] = None
+        self.track_len: float = 0.0
+        self.corners: List[Corner] = []
+        self.line: List[Optional[List[float]]] = []
+        self._reset_session(None)
+
+    # ---------------------------------------------------------------- state
+
+    def _reset_session(self, uid) -> None:
+        self.session_uid = uid
+        self.k: Dict[str, float] = {}           # learned decel correction per tyre class
+        self.zone: Optional[Zone] = None
+        self.last_d: Optional[float] = None
+        self.last_t: Optional[float] = None
+        self.lap: Optional[int] = None
+        self.lap_results: Dict[int, str] = {}
+        self.lap_line: Dict[int, List[float]] = {}
+        self.lap_clean = True
+        self.lap_pitted = False
+        self.lap_hit: set = set()               # id() of corners braked for this lap
+        self.trace: List[tuple] = []            # (t, d) for gate timing, ~40 s
+        self.pending_gates: List[tuple] = []    # (corner idx, zone, gate_in_d, gate_out_d)
+        self.flash: Optional[tuple] = None      # (until_t, result key, corner idx)
+        self.last_exit_t: Optional[float] = None
+        self.last_exit_corner: Optional[int] = None
+        self.armed_glow: Optional[int] = None
+        self.bb_plan: Dict[int, int] = {}       # corner idx -> bias to set before it
+        self.bb_done: set = set()
+        self.dirty = False
+
+    def _store_path(self) -> Optional[str]:
+        if not self.store_dir or self.track_id is None:
+            return None
+        return os.path.join(self.store_dir, f"track_{self.track_id}.json")
+
+    def _load_track(self, track_id: int, track_len: float) -> None:
+        self.save()   # unconfirmed corners are never written
+        self.track_id, self.track_len = track_id, float(track_len or 0)
+        self.corners, self.line = [], []
+        path = self._store_path()
+        if path and os.path.exists(path):
+            try:
+                with open(path, "r", encoding="utf-8") as f:
+                    data = json.load(f)
+                if abs(data.get("track_length", 0) - self.track_len) < 5:
+                    self.corners = [Corner.from_json(c) for c in data.get("corners", [])]
+                    self.line = data.get("line", [])
+                    self.log(f"brake helper: loaded {len(self.corners)} corners for track {track_id}")
+            except (OSError, ValueError, KeyError) as e:
+                self.log(f"brake helper: could not load {path}: {e}")
+        nbins = int(math.ceil(self.track_len / LINE_BIN_M)) if self.track_len else 0
+        if len(self.line) != nbins:
+            self.line = [None] * nbins
+
+    def save(self) -> None:
+        path = self._store_path()
+        if not path or not self.dirty:
+            return
+        try:
+            os.makedirs(os.path.dirname(path), exist_ok=True)
+            tmp = path + ".tmp"
+            with open(tmp, "w", encoding="utf-8") as f:
+                json.dump({"version": 1, "track_length": self.track_len,
+                           "corners": [c.to_json() for c in self.corners if c.confirmed],
+                           "line": self.line}, f)
+            os.replace(tmp, path)
+            self.dirty = False
+        except OSError as e:
+            self.log(f"brake helper: could not save {path}: {e}")
+
+    # ---------------------------------------------------------------- grip model
+
+    def conditions_grip(self, s) -> float:
+        """Grip from conditions only (1.0 = new slicks in the window, dry, light car)."""
+        cls = tyre_class(s.visual_compound)
+        w = s.weather if isinstance(s.weather, int) and 0 <= s.weather <= 6 else 0
+        g = _WET_GRIP[cls][w]
+        wear = _avg(s.tyre_wear)
+        if wear is not None:
+            g *= _clamp(1.0 - 0.0022 * wear, 0.8, 1.0)
+        temp = _avg(s.tyre_surface_temp)
+        if temp is not None and temp > 0:
+            lo, hi = _TEMP_WINDOW[cls]
+            off = lo - temp if temp < lo else temp - hi if temp > hi else 0.0
+            g *= 1.0 - min(0.12, 0.004 * off)
+        return g
+
+    @staticmethod
+    def mass_factor(s) -> float:
+        fuel = s.fuel_kg if s.fuel_kg is not None else 0.0
+        return (CAR_MASS_KG / (CAR_MASS_KG + max(0.0, fuel))) ** 0.6
+
+    def line_offset(self, s) -> Optional[float]:
+        if s.pos_x is None or not self.line or s.lap_distance is None:
+            return None
+        n = len(self.line)
+        b = int((s.lap_distance % self.track_len) // LINE_BIN_M) if self.track_len else 0
+        best = None
+        # lateral distance = distance to the line segments around this bin (not to a bin centre)
+        for i in (b - 1, b):
+            p0, p1 = self.line[i % n], self.line[(i + 1) % n]
+            if not p0 or not p1:
+                continue
+            sx, sz = p1[0] - p0[0], p1[1] - p0[1]
+            l2 = sx * sx + sz * sz
+            u = _clamp(((s.pos_x - p0[0]) * sx + (s.pos_z - p0[1]) * sz) / l2, 0.0, 1.0) if l2 > 1e-6 else 0.0
+            dist = math.hypot(s.pos_x - (p0[0] + u * sx), s.pos_z - (p0[1] + u * sz))
+            best = dist if best is None else min(best, dist)
+        return best
+
+    def car_ahead(self, s) -> Optional[tuple]:
+        """(gap m, closing m/s) to the nearest car ahead on track within 80 m."""
+        if s.lap_distance is None or not self.track_len:
+            return None
+        best = None
+        for d, v in s.others:
+            if d is None:
+                continue
+            gap = (d - s.lap_distance) % self.track_len
+            if 0.5 < gap < 80 and (best is None or gap < best[0]):
+                closing = ((s.speed_kmph or 0) - (v if v is not None else (s.speed_kmph or 0))) / 3.6
+                best = (gap, closing)
+        return best
+
+    def battle(self, s) -> tuple:
+        """(decel factor, extra margin m) from line offset and a car ahead."""
+        f, margin = 1.0, 0.0
+        off = self.line_offset(s)
+        if off is not None and 1.5 < off < 25.0:   # >25 m = bad data (pit lane, other layout)
+            f *= 1.0 - min(0.20, 0.04 * (off - 1.5))
+        ahead = self.car_ahead(s)
+        if ahead:
+            gap, closing = ahead
+            f *= 1.0 - 0.10 * _clamp((45.0 - gap) / 35.0, 0.0, 1.0)
+            if gap < 60:
+                margin += max(0.0, closing) * 0.25
+        return f, margin
+
+    # ---------------------------------------------------------------- brake point
+
+    def ref_for(self, corner: Corner, cls: str) -> Optional[Dict[str, float]]:
+        return corner.refs.get(cls) or corner.refs.get("dry") or next(iter(corner.refs.values()), None)
+
+    def brake_point(self, corner: Corner, s, v: float) -> Optional[tuple]:
+        """(point distance, target min speed m/s, a_now) or None if no braking needed."""
+        cls = tyre_class(s.visual_compound)
+        ref = self.ref_for(corner, cls)
+        if not ref:
+            return None
+        g = self.conditions_grip(s)
+        bf, margin = self.battle(s)
+        a = ref["a_norm"] * g * self.mass_factor(s) * self.k.get(cls, 1.0) * bf
+        vt = ref["vmin_norm"] * math.sqrt(g)
+        if v <= vt + 1.0 or a <= 0:
+            return None
+        dist = (v * v - vt * vt) / (2 * a)
+        return ref["apex"] - dist - margin, vt, a
+
+    # ---------------------------------------------------------------- corners
+
+    def _find_corner(self, apex_d: float) -> Optional[int]:
+        best, best_i = MATCH_M, None
+        for i, c in enumerate(self.corners):
+            d = abs(_wrap(c.apex - apex_d, self.track_len))
+            if d < best:
+                best, best_i = d, i
+        return best_i
+
+    def _next_corner(self, d: float) -> Optional[int]:
+        """Next corner whose apex is still ahead (with the 'just finished' one skipped)."""
+        if not self.corners:
+            return None
+        best, best_i = None, None
+        for i, c in enumerate(self.corners):
+            ahead = (c.apex - d) % self.track_len if self.track_len else c.apex - d
+            if i == self.last_exit_corner and ahead > self.track_len - 300:
+                continue
+            if best is None or ahead < best:
+                best, best_i = ahead, i
+        return best_i
+
+    def _add_corner(self, apex: float) -> int:
+        self.corners.append(Corner(apex=apex, confirmed=False))
+        self.corners.sort(key=lambda c: c.apex)
+        self.dirty = True
+        # indices shifted: drop per-lap state keyed by index
+        self.lap_results.clear()
+        self.bb_plan.clear()
+        return self._find_corner(apex)
+
+    # ---------------------------------------------------------------- main update
+
+    def update(self, s, t: float) -> Dict[str, Any]:
+        """Process one sample. t = seconds (monotonic). Returns the view dict."""
+        if not s.player or s.lap_distance is None or s.speed_kmph is None or not s.track_length:
+            return self._view_idle(s, "")
+        if s.track_id != self.track_id or abs((s.track_length or 0) - self.track_len) > 5:
+            self._load_track(s.track_id, s.track_length)
+            self._reset_session(s.session_uid)
+        elif s.session_uid != self.session_uid:
+            self.corners = [c for c in self.corners if c.confirmed]
+            self.save()
+            self._reset_session(s.session_uid)
+
+        d = s.lap_distance % self.track_len
+        v = s.speed_kmph / 3.6
+
+        # flashback / teleport: distance jumped back or far forward
+        if self.last_d is not None:
+            step = _wrap(d - self.last_d, self.track_len)
+            if step < -20 or step > 200:
+                self.zone = None
+                self.pending_gates.clear()
+                self.trace.clear()
+                self.flash = None
+        self.last_d, self.last_t = d, t
+
+        if s.pit_status:
+            self.zone = None
+            self.lap_clean = False
+            self.lap_pitted = True
+
+        # lap change: reset dots, learn line, plan bias changes
+        if s.lap_num != self.lap:
+            self._on_new_lap(s)
+        if s.lap_invalid:
+            self.lap_clean = False
+
+        # timing trace for segment gates
+        self.trace.append((t, s.lap_distance))
+        if len(self.trace) > 2400:
+            del self.trace[:600]
+
+        # racing line accumulation (this lap)
+        if s.pos_x is not None and not s.pit_status:
+            b = int(d // LINE_BIN_M)
+            acc = self.lap_line.setdefault(b, [0.0, 0.0, 0])
+            acc[0] += s.pos_x
+            acc[1] += s.pos_z
+            acc[2] += 1
+
+        self._track_zone(s, d, v, t)
+        self._check_gates(s)
+        return self._view(s, d, v, t)
+
+    # ---------------------------------------------------------------- zones
+
+    def _track_zone(self, s, d: float, v: float, t: float) -> None:
+        z = self.zone
+        brake = s.brake or 0.0
+        if z is None:
+            if brake >= BRAKE_ON and v > 60 / 3.6 and not s.pit_status:
+                ci = self._next_corner(d)
+                point = vt = None
+                if ci is not None:
+                    c = self.corners[ci]
+                    # only attach if the corner apex is reasonably close ahead
+                    if (c.apex - d) % self.track_len > 600:
+                        ci = None
+                    else:
+                        bp = self.brake_point(c, s, v)
+                        if bp:
+                            point, vt, _a = bp
+                self.zone = Zone(start_d=d, start_t=t, v_entry=v, bias=s.front_brake_bias, corner=ci,
+                                 point_d=point, v_target=vt, grip=self.conditions_grip(s),
+                                 lap_invalid=bool(s.lap_invalid))
+                self.armed_glow = None
+            return
+
+        z.frames += 1
+        z.peak = max(z.peak, brake)
+        if not z.traffic and z.end_d is None:
+            ahead = self.car_ahead(s)
+            z.traffic = bool(ahead and ahead[0] < 25)
+        z.lap_invalid = z.lap_invalid or bool(s.lap_invalid)
+        if v < z.min_v:
+            z.min_v, z.min_d = v, d
+        if brake >= 0.3 and s.wheel_slip:
+            slip = s.wheel_slip
+            if min(slip[2], slip[3]) < -LOCK_SLIP:
+                z.front_lock += 1
+            if min(slip[0], slip[1]) < -LOCK_SLIP:
+                z.rear_lock += 1
+        if brake < BRAKE_OFF and z.end_d is None:
+            z.end_d = d
+        elif brake >= BRAKE_ON and z.end_d is not None:
+            z.end_d = None   # trail-braking pulses: still the same zone
+        # zone over: off the brake and speed picking up again (or on the throttle)
+        if z.end_d is not None and (v > z.min_v + 3 / 3.6 or (s.throttle or 0) > 0.4):
+            self._close_zone(s, z, t)
+            self.zone = None
+        elif _wrap(d - z.start_d, self.track_len) > 1200:
+            self.zone = None   # something odd (spin, pit), drop it
+
+    def _close_zone(self, s, z: Zone, t: float) -> None:
+        drop_kmph = (z.v_entry - z.min_v) * 3.6
+        if drop_kmph < MIN_DROP_KMPH:
+            return
+        ci = self._find_corner(z.min_d)
+        if ci is None:
+            ci = self._add_corner(z.min_d)
+        c = self.corners[ci]
+        self.lap_hit.add(id(c))
+        cls = tyre_class(s.visual_compound)
+        zone_len = _wrap(z.min_d - z.start_d, self.track_len)
+        a_ach = (z.v_entry ** 2 - z.min_v ** 2) / (2 * zone_len) if zone_len > 5 else None
+        locked = z.frames and (z.front_lock + z.rear_lock) / z.frames > 0.10
+
+        # learned decel correction: achieved vs predicted for this corner's reference
+        ref = self.ref_for(c, cls)
+        if ref and a_ach and z.peak >= 0.9:
+            pred = ref["a_norm"] * z.grip * self.mass_factor(s) * self.k.get(cls, 1.0)
+            r = a_ach / pred if pred > 0 else 1.0
+            if locked:
+                r = min(r, 1.0) * 0.97
+            old = self.k.get(cls, 1.0)
+            self.k[cls] = _clamp(0.7 * old + 0.3 * (old * r), 0.85, 1.08)
+
+        # result vs the adjusted point at the moment braking started
+        result = None
+        if ref and z.point_d is not None and z.v_target is not None:
+            start_err = _wrap(z.start_d - z.point_d, self.track_len)   # + = braked later
+            apex_err = _wrap(z.min_d - ref["apex"], self.track_len)
+            slow = (z.v_target - z.min_v) * 3.6                          # km/h below target
+            slow_tol = max(8.0, 0.05 * z.v_target * 3.6)
+            overshoot = apex_err > 12 or slow > 5
+            if overshoot and start_err > 8:
+                result = "earlier"
+            elif slow > slow_tol:
+                result = "less"
+            elif start_err < -15 and not overshoot:
+                result = "later"
+            elif z.peak < 0.85 and apex_err > 10:
+                result = "harder"
+            else:
+                result = "good"
+            if z.traffic and result in ("less", "later", "harder"):
+                result = "good"   # held up by the car ahead: only overshoots are on the driver
+            self.last_eval = {"corner": ci, "start_err": round(start_err, 1), "apex_err": round(apex_err, 1),
+                              "slow_kmph": round(slow, 1), "peak": round(z.peak, 2), "result": result}
+            self.lap_results[ci] = result
+            self.flash = (t + FLASH_S, result, ci)
+
+        # brake bias learning from lock-ups and tyre wear
+        if z.bias is not None and z.frames >= 10:
+            fr = z.front_lock / z.frames
+            rr = z.rear_lock / z.frames
+            delta = 0.0
+            if fr > 0.08 and fr > 1.5 * rr:
+                delta = -2.0 if fr > 0.2 else -1.0
+            elif rr > 0.05 and rr > 1.5 * fr:
+                delta = 2.0 if rr > 0.15 else 1.0
+            wear = s.tyre_wear
+            if wear and len(wear) == 4:
+                if (wear[2] + wear[3]) / 2 - (wear[0] + wear[1]) / 2 > 8:
+                    delta -= 0.5
+            obs = _clamp(z.bias + delta, 50.0, 70.0)
+            c.bias_target = obs if c.bias_target is None else 0.6 * c.bias_target + 0.4 * obs
+            c.bias_n += 1
+            c.bias_weight = 0.7 * c.bias_weight + 0.3 * (1.0 + 10 * (fr + rr))
+            self.dirty = True
+
+        if self.last_exit_t is not None and self.last_exit_corner is not None:
+            gap = z.start_t - self.last_exit_t
+            if 0 < gap < 60:
+                c.gap_prev_s = gap if c.gap_prev_s is None else 0.7 * c.gap_prev_s + 0.3 * gap
+        self.last_exit_t, self.last_exit_corner = t, ci
+        if ci == len(self.corners) - 1:
+            # out of the last corner: plan next lap's bias changes now, so the first
+            # corner's tip shows on the run to the line
+            self.bb_done = set()
+            self.bb_plan = self.plan_bias(s.front_brake_bias)
+
+        # reference candidate: timed between gates once the car passes gate_out
+        if a_ach and not z.lap_invalid and not locked:
+            own = c.refs.get(cls)
+            gate_in = own["gate_in"] if own else z.start_d - GATE_IN_M
+            gate_out = own["gate_out"] if own else z.min_d + GATE_OUT_M
+            self.pending_gates.append((ci, z, cls, gate_in, gate_out, a_ach))
+
+    def _time_at(self, lap_dist_target: float) -> Optional[float]:
+        """Interpolated time when the car passed a lap distance (raw lap distance, may be unwrapped)."""
+        tr = self.trace
+        for i in range(len(tr) - 1, 0, -1):
+            (t1, d1), (t0, d0) = tr[i], tr[i - 1]
+            dd = _wrap(d1 - d0, self.track_len)
+            if dd <= 0:
+                continue
+            x = _wrap(lap_dist_target - d0, self.track_len)
+            if 0 <= x <= dd:
+                return t0 + (t1 - t0) * x / dd
+        return None
+
+    def _check_gates(self, s) -> None:
+        if not self.pending_gates:
+            return
+        d = s.lap_distance % self.track_len
+        keep = []
+        for item in self.pending_gates:
+            ci, z, cls, gin, gout, a_ach = item
+            if _wrap(d - gout, self.track_len) < 0:
+                keep.append(item)
+                continue
+            if ci >= len(self.corners):
+                continue
+            t_in, t_out = self._time_at(gin), self._time_at(gout)
+            if t_in is None or t_out is None or t_out <= t_in or s.lap_invalid:
+                continue
+            seg = t_out - t_in
+            c = self.corners[ci]
+            ref = c.refs.get(cls)
+            faster = ref is not None and seg < ref["seg_t"] - 0.005
+            if z.traffic:
+                # held up by a car: only a provisional reference until a clean one exists
+                better = ref is None or (ref.get("prov") and faster)
+            else:
+                better = ref is None or ref.get("prov") or faster
+            if better:
+                g = z.grip
+                c.refs[cls] = {
+                    "start": round(z.start_d, 1), "apex": round(z.min_d, 1),
+                    "v_entry": round(z.v_entry, 2), "vmin": round(z.min_v, 2),
+                    "a_norm": round(a_ach / (g * self.mass_factor(s)), 3),
+                    "vmin_norm": round(z.min_v / math.sqrt(g), 2),
+                    "seg_t": round(seg, 3), "gate_in": round(gin, 1), "gate_out": round(gout, 1),
+                }
+                if z.traffic:
+                    c.refs[cls]["prov"] = True
+                c.apex = 0.8 * c.apex + 0.2 * z.min_d if ref else z.min_d
+                self.dirty = True
+        self.pending_gates = keep
+
+    # ---------------------------------------------------------------- laps / bias plan
+
+    def _on_new_lap(self, s) -> None:
+        if self.lap is not None and self.lap_clean and self.lap_line:
+            for b, (sx, sz, n) in self.lap_line.items():
+                if 0 <= b < len(self.line) and n:
+                    p = [sx / n, sz / n]
+                    old = self.line[b]
+                    self.line[b] = [round(p[0], 2), round(p[1], 2)] if not old else \
+                        [round(0.7 * old[0] + 0.3 * p[0], 2), round(0.7 * old[1] + 0.3 * p[1], 2)]
+            self.dirty = True
+        if self.lap is not None and s.lap_num == self.lap + 1:
+            self._end_of_lap()
+        elif self.lap is not None:
+            # jumped laps (flashback, session restart): forget corners found on the unfinished lap
+            self._drop_corners([c for c in self.corners if not c.confirmed])
+        if self.lap is not None:
+            self.save()
+        self.lap = s.lap_num
+        self.lap_results = {}
+        self.lap_line = {}
+        self.lap_clean = not s.pit_status
+        self.lap_pitted = bool(s.pit_status)
+        self.lap_hit = set()
+        if not self.bb_plan:
+            self.bb_done = set()
+            self.bb_plan = self.plan_bias(s.front_brake_bias)
+
+    def _end_of_lap(self) -> None:
+        """A lap was completed: confirm corners found on it, retire corners never braked for."""
+        if self.lap_pitted:
+            self._drop_corners([c for c in self.corners if not c.confirmed])
+            return
+        drop = []
+        for c in self.corners:
+            if not c.confirmed:
+                c.confirmed = True
+                self.dirty = True
+            elif id(c) in self.lap_hit:
+                c.misses = 0
+            else:
+                c.misses += 1
+                if c.misses >= 3:
+                    drop.append(c)
+        self._drop_corners(drop)
+
+    def _drop_corners(self, drop: List["Corner"]) -> None:
+        if not drop:
+            return
+        self.corners = [c for c in self.corners if all(c is not d for d in drop)]
+        self.lap_results.clear()
+        self.bb_plan.clear()
+        self.pending_gates.clear()
+        self.zone = None
+        self.dirty = True
+
+    def plan_bias(self, current: Optional[int]) -> Dict[int, int]:
+        """Pick at most 3 cyclic bias changes per lap with the most benefit.
+        Returns {corner index: bias to have set before that corner}."""
+        if current is None:
+            return {}
+        known = [i for i, c in enumerate(self.corners) if c.bias_n >= 2 and c.bias_target is not None]
+        if not known:
+            return {}
+        target = {i: round(self.corners[i].bias_target) for i in known}
+        weight = {i: self.corners[i].bias_weight for i in known}
+        eligible = [i for i in known
+                    if self.corners[i].gap_prev_s is not None and self.corners[i].gap_prev_s >= BB_MIN_GAP_S]
+
+        def cost(applied: Dict[int, int]) -> float:
+            return sum(weight[i] * abs(target[i] - applied[i]) for i in known)
+
+        base = cost({i: current for i in known})
+        best_cost, best_plan = base, {}
+        for k in (1, 2, 3):
+            for combo in itertools.combinations(eligible, k):
+                vals = {ci: target[ci] for ci in combo}
+                order = sorted(combo)
+                # value in effect at each corner (cyclic: before the first change, the last one holds)
+                applied = {}
+                for i in known:
+                    prev = [c for c in order if c <= i]
+                    applied[i] = vals[prev[-1]] if prev else vals[order[-1]]
+                seq = [vals[c] for c in order]
+                changes = sum(1 for j in range(len(seq)) if seq[j] != seq[j - 1]) if len(seq) > 1 else 0
+                if changes > BB_MAX_CHANGES:
+                    continue
+                if k > 1 and changes < k - 1:
+                    continue   # redundant change points
+                c_ = cost(applied) + 0.3 * changes
+                if c_ < best_cost - 0.5:
+                    best_cost, best_plan = c_, vals
+        return best_plan
+
+    # ---------------------------------------------------------------- view
+
+    def _view_idle(self, s, label: str) -> Dict[str, Any]:
+        return {"fill": 0.0, "color": "#f2f5f8", "glow": False, "label": label, "labelColor": "#8d99a6",
+                "dots": [], "current": -1, "bias": getattr(s, "front_brake_bias", None) or 0,
+                "biasKnown": getattr(s, "front_brake_bias", None) is not None, "biasDelta": 0,
+                "mode": "idle"}
+
+    def _view(self, s, d: float, v: float, t: float) -> Dict[str, Any]:
+        view = self._view_idle(s, "")
+        view["dots"] = [RESULTS[self.lap_results[i]][0] if i in self.lap_results else ""
+                        for i in range(len(self.corners))]
+        if not self.corners or not any(c.refs for c in self.corners):
+            view["label"] = "Learning"
+            return view
+
+        ci = self.zone.corner if self.zone and self.zone.corner is not None else self._next_corner(d)
+        view["current"] = ci if ci is not None else -1
+
+        # brake bias tip for the next corner: from the previous corner's exit until braking
+        if ci is not None and ci in self.bb_plan and s.front_brake_bias is not None and not self.zone:
+            delta = self.bb_plan[ci] - s.front_brake_bias
+            if ci not in self.bb_done:
+                view["biasDelta"] = delta
+                if delta == 0:
+                    self.bb_done.add(ci)
+        elif self.zone and ci is not None:
+            self.bb_done.add(ci)
+
+        # result flash wins
+        if self.flash and t < self.flash[0]:
+            color, name = RESULTS[self.flash[1]]
+            view.update({"fill": 1.0, "color": color, "label": name, "labelColor": color, "mode": "result"})
+            return view
+        self.flash = None
+
+        z = self.zone
+        if z is not None:
+            vt = z.v_target
+            if vt is None:
+                view.update({"label": "Braking", "labelColor": "#ff3b30", "mode": "brake",
+                             "fill": 1.0, "color": "#ff3b30"})
+                return view
+            span = max(1e-3, z.v_entry ** 2 - vt ** 2)
+            drain = _clamp((v * v - vt * vt) / span, 0.0, 1.0)
+            if drain <= 0.02 or z.end_d is not None:
+                view.update({"label": "Off the brake", "labelColor": "#e9eef3", "mode": "release",
+                             "fill": 0.0})
+            else:
+                view.update({"label": "Braking", "labelColor": "#ff3b30", "mode": "brake",
+                             "fill": drain, "color": "#ff3b30"})
+            return view
+
+        if ci is None:
+            return view
+        bp = self.brake_point(self.corners[ci], s, v)
+        if not bp:
+            return view
+        point = bp[0]
+        to_go = _wrap(point - d, self.track_len)
+        t_to = to_go / max(v, 1.0)
+        if t_to > WHITE_LEAD_S:
+            self.armed_glow = None
+            return view
+        if t_to > self.warn_s:
+            view.update({"fill": (WHITE_LEAD_S - t_to) / WHITE_LEAD_S, "color": "#f2f5f8", "mode": "approach"})
+            return view
+        if t_to > 0:
+            x = 1.0 - t_to / self.warn_s               # 0 = yellow, 1 = red
+            g, b = int(0xc5 * (1 - x) + 0x3b * x), int(0x3d * (1 - x) + 0x30 * x)
+            col = f"#ff{g:02x}{b:02x}"
+            view.update({"fill": (WHITE_LEAD_S - t_to) / WHITE_LEAD_S, "color": col,
+                         "label": "Get ready", "labelColor": "#ffc53d", "mode": "warn"})
+            return view
+        if to_go > -60:   # at / just past the point and not braking yet
+            view.update({"fill": 1.0, "color": "#ff3b30", "glow": True, "label": "Brake",
+                         "labelColor": "#ff3b30", "mode": "point"})
+        return view
