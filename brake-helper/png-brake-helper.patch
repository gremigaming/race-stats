+def test_braking_too_late_says_brake_earlier(tmp_path):
+    eng = be.BrakeEngine(store_dir=str(tmp_path))
+    run(eng, lap_samples(2))
+    global CORNERS
+    saved = CORNERS
+    try:
+        # same entry, braking 40 m later and overshooting the apex
+        CORNERS = [(1040.0, 32.0), (2200.0, 40.0)]
+        views = run(eng, lap_samples(3, t0=1000.0)[-int(60 * 40):])
+    finally:
+        CORNERS = saved
+    labels = {v["label"] for s, v in views if v["mode"] == "result"}
+    assert "Brake earlier" in labels
