+++ b/apps/hud/ui/overlays/brake_helper/brake_helper.qml
@@ -0,0 +1,201 @@
+import QtQuick
+import QtQuick.Window
+
+// Brake helper capsule: [ BB | bar + corner dots + status label ]
+// All state comes from BrakeEngine via updateView(view).
+Window {
+    id: root
+    visible: true
+
+    property real scaleFactor: 1.0
+    readonly property int baseWidth: 380
+    readonly property int baseHeight: 76
+
+    width: baseWidth * scaleFactor
+    height: baseHeight * scaleFactor
+    color: "transparent"
+    flags: Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint
+
+    // ---------------- state (from engine) ----------------
+    property real fill: 0.0
+    property color barColor: "#f2f5f8"
+    property bool glow: false
+    property string label: ""
+    property color labelColor: "#8d99a6"
+    property var dots: []
+    property int current: -1
+    property int bias: 0
+    property bool biasKnown: false
+    property int biasDelta: 0
+
+    readonly property color fg: "#e9eef3"
+    readonly property color muted: "#8d99a6"
+    readonly property color up: "#34d27b"
+    readonly property color down: "#ff3b30"
+
+    function updateView(v) {
+        fill = Math.max(0, Math.min(1, v.fill))
+        barColor = v.color
+        glow = v.glow
+        label = v.label
+        labelColor = v.labelColor
+        dots = v.dots
+        current = v.current
+        bias = v.bias
+        biasKnown = v.biasKnown
+        biasDelta = v.biasDelta
+    }
+
+    Item {
+        id: scaledRoot
+        anchors.centerIn: parent
+        width: root.baseWidth
+        height: root.baseHeight
+        transform: Scale {
+            xScale: root.scaleFactor
+            yScale: root.scaleFactor
+            origin.x: root.baseWidth / 2
+            origin.y: root.baseHeight / 2
+        }
+
+        // glow halo at the brake point
+        Rectangle {
+            anchors.fill: capsule
+            anchors.margins: -5
+            radius: capsule.radius + 5
+            color: "transparent"
+            border.width: 5
+            border.color: root.barColor
+            opacity: root.glow ? 0.35 : 0.0
+            Behavior on opacity { NumberAnimation { duration: 120 } }
+        }
+
+        Rectangle {
+            id: capsule
+            anchors.fill: parent
+            anchors.margins: 8
+            radius: 14
+            border.width: 1
+            border.color: Qt.rgba(1, 1, 1, 0.08)
+            gradient: Gradient {
+                GradientStop { position: 0.0; color: Qt.rgba(14/255, 18/255, 24/255, 0.80) }
+                GradientStop { position: 1.0; color: Qt.rgba(8/255, 10/255, 14/255, 0.72) }
+            }
+
+            // ---------------- BB block ----------------
+            Item {
+                id: bbBlock
+                anchors.left: parent.left
+                anchors.top: parent.top
+                anchors.bottom: parent.bottom
+                width: 62
+
+                Column {
+                    anchors.centerIn: parent
+                    spacing: 1
+                    Text {
+                        anchors.horizontalCenter: parent.horizontalCenter
+                        text: "BB"
+                        color: root.muted
+                        font.pixelSize: 9
+                        font.letterSpacing: 1.5
+                        font.bold: true
+                    }
+                    Text {
+                        anchors.horizontalCenter: parent.horizontalCenter
+                        text: root.biasKnown ? root.bias : "--"
+                        color: root.fg
+                        font.pixelSize: 20
+                        font.bold: true
+                    }
+                    Text {
+                        anchors.horizontalCenter: parent.horizontalCenter
+                        height: 13
+                        text: root.biasDelta > 0 ? "▲" + root.biasDelta
+                            : root.biasDelta < 0 ? "▼" + (-root.biasDelta) : ""
+                        color: root.biasDelta > 0 ? root.up : root.down
+                        font.pixelSize: 13
+                        font.bold: true
+                    }
+                }
+
+                Rectangle {
+                    anchors.right: parent.right
+                    anchors.top: parent.top
+                    anchors.bottom: parent.bottom
+                    anchors.topMargin: 8
+                    anchors.bottomMargin: 8
+                    width: 1
+                    color: Qt.rgba(1, 1, 1, 0.08)
+                }
+            }
+
+            // ---------------- bar + dots ----------------
+            Item {
+                id: mainArea
+                anchors.left: bbBlock.right
+                anchors.right: parent.right
+                anchors.top: parent.top
+                anchors.bottom: parent.bottom
+                anchors.leftMargin: 14
+                anchors.rightMargin: 14
+
+                Rectangle {
+                    id: bar
+                    anchors.left: parent.left
+                    anchors.right: parent.right
+                    y: 16
+                    height: 8
+                    radius: 4
+                    color: Qt.rgba(1, 1, 1, 0.07)
+
+                    Rectangle {
+                        anchors.left: parent.left
+                        anchors.top: parent.top
+                        anchors.bottom: parent.bottom
+                        width: parent.width * root.fill
+                        radius: 4
+                        visible: root.fill > 0.001
+                        gradient: Gradient {
+                            orientation: Gradient.Horizontal
+                            GradientStop { position: 0.0; color: Qt.darker(root.barColor, 1.45) }
+                            GradientStop { position: 1.0; color: root.barColor }
+                        }
+                    }
+                }
+
+                Row {
+                    id: dotsRow
+                    anchors.left: parent.left
+                    anchors.top: bar.bottom
+                    anchors.topMargin: 9
+                    spacing: root.dots.length > 14 ? 3 : 5
+                    readonly property int dw: root.dots.length > 14 ? 4 : 6
+                    Repeater {
+                        model: root.dots.length
+                        Rectangle {
+                            width: index === root.current ? dotsRow.dw * 2 + 2 : dotsRow.dw
+                            height: dotsRow.dw
+                            radius: dotsRow.dw / 2
+                            color: root.dots[index] !== ""
+                                   ? root.dots[index]
+                                   : (index === root.current ? Qt.rgba(1, 1, 1, 0.55) : Qt.rgba(1, 1, 1, 0.16))
+                            Behavior on width { NumberAnimation { duration: 200 } }
+                        }
+                    }
+                }
+
+                Text {
+                    anchors.right: parent.right
+                    anchors.verticalCenter: dotsRow.verticalCenter
+                    text: root.label.toUpperCase()
+                    color: root.labelColor
+                    opacity: 0.85
+                    font.pixelSize: 10
+                    font.bold: true
+                    font.letterSpacing: 1.6
+                }
+            }
+        }
+    }
+}
