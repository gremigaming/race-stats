+def test_brake_point_matches_reference_and_moves_with_conditions(tmp_path):
+    eng = be.BrakeEngine(store_dir=str(tmp_path))
+    run(eng, lap_samples(2))
+    c = eng.corners[0]
+    ref = c.refs["dry"]
+    base = types.SimpleNamespace(**vars(lap_samples(1)[0][1]))
+    base.lap_distance = 300.0
+    base.pos_x = 300.0
+    p0, _, _ = eng.brake_point(c, base, ref["v_entry"])
+    assert abs(p0 - ref["start"]) < 8
+
+    worn = types.SimpleNamespace(**{**vars(base), "tyre_wear": [60.0] * 4})
+    wet = types.SimpleNamespace(**{**vars(base), "weather": 3})
+    fast = ref["v_entry"] + 5
+    assert eng.brake_point(c, worn, ref["v_entry"])[0] < p0 - 3
+    assert eng.brake_point(c, wet, ref["v_entry"])[0] < p0 - 15
+    assert eng.brake_point(c, base, fast)[0] < p0 - 5
+    # close behind a slower car: earlier
+    behind = types.SimpleNamespace(**{**vars(base), "others": [[base.lap_distance + 15, 250.0]]})
+    assert eng.brake_point(c, behind, ref["v_entry"])[0] < p0 - 5
+    # 5 m off the normal line: earlier
+    offline = types.SimpleNamespace(**{**vars(base), "pos_z": 5.0})
+    assert eng.brake_point(c, offline, ref["v_entry"])[0] < p0 - 5
+
