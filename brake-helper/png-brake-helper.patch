+def test_bias_tips_follow_front_lockups(tmp_path):
+    eng = be.BrakeEngine(store_dir=str(tmp_path))
+    views = run(eng, lap_samples(5, front_lock_at=950.0))
+    c0 = eng.corners[0]
+    assert c0.bias_target < 55
+    tips = [(s.lap_num, v["current"], v["biasDelta"]) for s, v in views if v["biasDelta"]]
+    assert tips and all(d < 0 for _, ci, d in tips if ci == 0)
