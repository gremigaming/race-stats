+def test_bias_plan_limits():
+    eng = be.BrakeEngine()
+    eng.track_len = TRACK
+    eng.corners = [be.Corner(apex=100.0 * i + 50) for i in range(8)]
+    for i, c in enumerate(eng.corners):
+        c.bias_n = 3
+        c.bias_target = 50 + 3 * i
+        c.gap_prev_s = 3.0 if i % 2 else 8.0   # odd corners come too soon after the previous one
+    plan = eng.plan_bias(56)
+    assert plan
+    assert all(ci % 2 == 0 for ci in plan)
+    vals = [plan[k] for k in sorted(plan)]
+    changes = sum(1 for j in range(len(vals)) if vals[j] != vals[j - 1]) if len(vals) > 1 else 0
+    assert changes <= 3
+
