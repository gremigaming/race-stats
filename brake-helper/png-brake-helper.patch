+# SOFTWARE.
+# pylint: skip-file
+"""Brake helper engine tests (synthetic laps, no Qt)."""
+
+import importlib.util
+import math
+import types
+from pathlib import Path
+
+import pytest
+
+_spec = importlib.util.spec_from_file_location(
+    "brake_engine",
+    Path(__file__).resolve().parents[1] / "apps/hud/ui/overlays/brake_helper/brake_engine.py")
+be = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(be)
+
+TRACK = 3000.0
+CORNERS = [(1000.0, 25.0), (2200.0, 40.0)]   # apex distance, min speed m/s
+DECEL = 30.0
+ACCEL = 9.0
+VMAX = 85.0
+
+
+def speed_at(d: float) -> float:
+    v = VMAX
+    for apex, vmin in CORNERS:
+        for a in (apex, apex - TRACK, apex + TRACK):
+            if d <= a:   # braking towards it
+                v = min(v, math.sqrt(vmin ** 2 + 2 * DECEL * (a - d)))
+            else:        # accelerating away
+                v = min(v, math.sqrt(vmin ** 2 + 2 * ACCEL * (d - a)))
+    return v
+
+
+def lap_samples(n_laps=3, t0=0.0, bias=56, front_lock_at=None, others_fn=None, **extra):
+    """60 Hz samples; brake = 1 where the profile is decelerating."""
+    out, t, d, lap = [], t0, 0.0, 1
+    dt = 1 / 60
+    while lap <= n_laps:
+        v = speed_at(d)
+        braking = speed_at(d + 0.5) < v - 0.05
+        slip = [-0.02] * 4
+        if braking and front_lock_at is not None and abs(d - front_lock_at) < 80:
+            slip = [-0.02, -0.02, -0.3, -0.3]
+        s = dict(player=True, track_id=7, track_length=TRACK, session_uid=1, lap_num=lap, lap_distance=d,
+                 lap_invalid=False, pit_status=0, speed_kmph=v * 3.6, throttle=0.0 if braking else 1.0,
+                 brake=1.0 if braking else 0.0, tyre_surface_temp=[95] * 4, front_brake_bias=bias,
+                 fuel_kg=10.0, visual_compound=16, tyre_wear=[5.0] * 4, wheel_slip=slip,
+                 pos_x=d, pos_z=0.0, weather=0, rain_pct=0,
+                 others=others_fn(d, lap) if others_fn else [])
+        s.update(extra)
+        out.append((t, types.SimpleNamespace(**s)))
+        t += dt
+        d += v * dt
+        if d >= TRACK:
+            d -= TRACK
+            lap += 1
+    return out
+
+
+def run(engine, samples):
+    views = []
+    for t, s in samples:
+        views.append((s, engine.update(s, t)))
+    return views
+
+
+def test_learns_corners_and_reference(tmp_path):
+    eng = be.BrakeEngine(store_dir=str(tmp_path))
+    run(eng, lap_samples(2))
+    assert len(eng.corners) == 2
+    for c, (apex, vmin) in zip(eng.corners, CORNERS):
+        ref = c.refs["dry"]
+        assert abs(ref["apex"] - apex) < 5
+        assert abs(ref["vmin"] - vmin) < 1.5
+    eng.save()
+    assert (tmp_path / "track_7.json").exists()
+
