+def test_bar_phases_and_results(tmp_path):
+    eng = be.BrakeEngine(store_dir=str(tmp_path))
+    views = run(eng, lap_samples(3))
+    modes = {v["mode"] for s, v in views if s.lap_num == 3}
+    assert {"approach", "warn", "brake", "result"} <= modes
+    results = [v["label"] for s, v in views if s.lap_num == 3 and v["mode"] == "result"]
+    assert results and set(results) == {"Good"}
+    last = [v for s, v in views if s.lap_num == 3][-1]
+    assert len(last["dots"]) == 2
